alias: Autokonsumpcja Wallbox
description: Reaguje co minutę, odporna na błędy Local Tuya i 0W.
triggers:
  - trigger: time_pattern
    minutes: /1
  - trigger: state
    entity_id: sensor.energia_netto_godzina
  - trigger: numeric_state
    entity_id: sensor.moc_chwilowa_zamel
    above: 1000
    for: "00:00:10"
conditions:
  - condition: state
    entity_id: sun.sun
    state: above_horizon
  - condition: template
    value_template: |
      {{ trigger.platform == 'time_pattern' or 
         (now() - this.attributes.last_triggered | default(today_at(), true)).total_seconds() > 45 }}
  - condition: template
    value_template: |-
      {{ states('sensor.wallbox_status') in [
        'plugged_in','charging','waiting','waiting_for_authorization','charged',
        'Oczekiwanie na autoryzację'
      ] }}
actions:
  - action: number.set_value
    target:
      entity_id: "{{ wallbox_number }}"
    data:
      value: "{{ target_current }}"
  - if:
      - condition: template
        value_template: >-
          {{ not is_state('sensor.wallbox_status', 'charging') and energia_h <
          -0.05 }}
    then:
      - action: button.press
        target:
          entity_id: "{{ button_start }}"
  - action: persistent_notification.create
    data:
      title: "Debug EV: {{ target_current }}A"
      message: >-
        Moc sieci: {{ net_power_w }}W, Ładowarka: {{ ev_power_w }}W. Zapas: {{
        energia_h }}kWh. Czas: {{ poz_min }}min.
      notification_id: debug_wallbox
mode: restart
variables:
  wallbox_number: number.wallbox_charge_current
  button_start: button.wallbox_start_charging
  voltage: "{{ states('sensor.wallbox_voltage_a') | float(240) }}"
  current_amps: "{{ states('number.wallbox_charge_current') | float(8) }}"
  raw_ev_power: "{{ states('sensor.wallbox_power') | float(0) }}"
  ev_power_w: "{{ raw_ev_power if raw_ev_power > 150 else (current_amps * voltage) }}"
  net_power_w: "{{ states('sensor.moc_chwilowa_zamel') | float(0) }}"
  energia_h: "{{ states('sensor.energia_netto_godzina') | float(0) }}"
  poz_min: "{{ states('sensor.pozostale_minuty') | float(0) }}"
  prognoza: "{{ states('sensor.prognozowany_uzysk') | float(0) }}"
  target_current: >
    {% set safe_min = poz_min if poz_min > 2 else 2 %}

    {# ZMIANA 1: Jeśli mamy dług (energia_h > 0), symulujemy spłatę w max 5
    minut #} {% set burn_min = safe_min if energia_h <= 0 else [safe_min, 5] |
    min %} {% set burn_power_w = ((-energia_h + prognoza) * 60000) / burn_min %}

    {# Formuła: Obecna moc EV - Bilans sieci + spalanie zapasu #} {% set
    target_power_w = ev_power_w - net_power_w + burn_power_w %} {% set
    calc_current = target_power_w / voltage %}

    {% if target_power_w <= 0 and (energia_h + prognoza) >= 0 %}
      8
    {% else %}
      {% set c = calc_current | round(0) | int %}
      
      {# ZMIANA 2: Twardy bezpiecznik - brak wysokich prądów przy długu #}
      {% if energia_h > 0 and c > 20 %}
         {% set c = 20 %}
      {% endif %}
      
      {% if c < 8 %} 8
      {% elif c > 28 %} 28
      {% else %} {{ c }} {% endif %}
    {% endif %}
